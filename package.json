{
  "name": "@commit-capital/bugfix-button",
  "version": "0.1.0",
  "description": "A drop-in Feedback button that files GitHub issues, plus a Claude routine that fixes them.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "files": [
    "dist",
    "ROUTINE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "routine": "node scripts/render-routine.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
